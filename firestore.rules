rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn();
      // Advanced: Custom claims or admin collection control can be added
      // return isSignedIn() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Widgets collection
    match /widgets/{widgetId} {
      // Anyone can read (public)
      allow read: if true;
      
      // Only admin can write
      allow create, update, delete: if isAdmin();
    }

    // Managers collection
    match /managers/{managerId} {
      // Anyone can read (public)
      allow read: if true;

      // Only admin can write
      allow create, update, delete: if isAdmin();
    }
    
    // Admin users collection (optional - available in the future)
    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false; // Can only be added from Firebase Console
    }
    
    // Analytics and stats (for the future)
    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if true; // Anyone can submit analytics
    }
  }
}
