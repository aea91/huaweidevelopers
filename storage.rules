rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'ankaraarifemre@gmail.com'
      ];
    }
    
    function isValidImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isValidSize() {
      // Max 5MB
      return request.resource.size < 5 * 1024 * 1024;
    }
    
    // Widget images folder (GIF, PNG, JPG, JPEG, WebP)
    match /widget_gifs/{imageFile} {
      // Anyone can read (public)
      allow read: if true;
      
      // Only admin can upload and delete
      allow create, update: if isAdmin() && isValidImage() && isValidSize();
      allow delete: if isAdmin();
    }
    
    // All other files
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
